{
  "about": "Structural conformance for tools/shot --conform. Everything but 'expected' is hand-written; 'expected' is generated: run `tools/shot --derive-conformance` after a library change and commit the diff with it. A value that differs between two viewports of one class is stored as null (or '*' per grid track) and not asserted.",
  "tolerancePx": 1,
  "phoneMaxWidth": 640,
  "viewports": {
    "desktop": [
      [1600, 1000],
      [1440, 900]
    ],
    "phone": [
      [400, 860],
      [380, 800]
    ]
  },
  "shapes": {
    "workbench": "workbench.html?product=loom",
    "flow": "flow.html#datasheets",
    "list": "list.html#list",
    "settings": "settings.html#overview",
    "overview": "overview.html#overview",
    "components": "components.html"
  },
  "productPage": "workbench.html?product={product}",
  "products": ["loom", "trace", "canvas", "mesh"],
  "tokens": ["--ground", "--well", "--field", "--ink", "--ink-2", "--ink-3", "--rule", "--rule-strong", "--ember", "--quench", "--danger", "--warn"],
  "productTokens": ["--temper", "--temper-text", "--on-temper"],
  "checks": [
    {
      "id": "body",
      "selector": "body",
      "props": ["fontFamily", "fontSize", "lineHeight", "color", "backgroundColor"]
    },
    {
      "id": "wb",
      "selector": ".wb",
      "props": ["display", "gridTemplateColumns"]
    },
    {
      "id": "titlebar",
      "selector": ".titlebar",
      "props": ["height", "backgroundColor", "borderBottomWidth", "borderBottomColor", "paddingLeft", "fontSize"]
    },
    {
      "id": "vhead",
      "selector": ".vhead",
      "props": ["height", "backgroundColor", "borderBottomWidth"]
    },
    {
      "id": "statusbar",
      "selector": ".statusbar",
      "props": ["height", "backgroundColor", "borderTopWidth", "fontSize"]
    },
    {
      "id": "btn",
      "selector": ".btn:not(.icon, .sm, .primary, .ember)",
      "props": ["height", "fontSize", "fontWeight", "borderRadius"]
    },
    {
      "id": "input",
      "selector": ".input",
      "props": ["height", "fontSize", "borderRadius", "backgroundColor"]
    },
    {
      "id": "card",
      "selector": ".card",
      "props": ["backgroundColor", "borderTopWidth", "borderTopColor", "borderRadius"]
    }
  ],
  "check": {
    "about": "Exceptions for tools/check. hexAllowFiles: files that may define colours (the library itself, whose paper sheets are always light, and the reference pages' own demo.css). hexAllowValues: colours allowed anywhere. exclude: paths skipped in any tree, relative to it. styleRepoExclude: paths skipped when the tree is the style repo itself (it has runtime-files.txt): the vendored demo assets and these tools. A hex colour in a data-* attribute is data (a layer colour), not chrome. A line, or the line above it, carrying 'check-ok' and a reason is skipped for every rule.",
    "hexAllowFiles": ["tokens.css", "theme.css", "pages.css", "demo.css"],
    "hexAllowValues": [],
    "exclude": [],
    "styleRepoExclude": ["demo/assets", "tools"]
  },
